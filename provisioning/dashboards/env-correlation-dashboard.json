          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT\n\ttime_bucket('10 minutes', n.ts) AS time,\n\tconcat(COALESCE(s.display_name, n.vessel_id), ' — Relative Wind (kts)') AS metric,\n\tAVG(n.rel_wind_speed_kts) AS value\nFROM nav_data n\nLEFT JOIN ships s ON s.vessel_id = n.vessel_id\nWHERE $__timeFilter(n.ts)\n\tAND n.vessel_id IN (SELECT vessel_id FROM ships WHERE src IN (${ship:sqlstring}) AND vessel_id IS NOT NULL)\n\tAND n.rel_wind_speed_kts IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1"
