  "panels": [
    {
      "id": 1,
      "title": "Throughput (Upload / Download)",
      "description": "iperf3 throughput split by traffic direction, time-aligned with environmental panels below.",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "cf1s1g3beeccge"
      },
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Throughput (Mbps)",
            "axisPlacement": "left",
            "drawStyle": "line",
            "fillOpacity": 5,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 4,
            "showPoints": "always",
            "spanNulls": true,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "unit": "Mbps"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "calcs": [
            "mean"
          ],
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf1s1g3beeccge"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT\n\t$__time(r.ts),\n\tconcat(COALESCE(s.display_name, r.src), ' → ', r.dst, ' [', coalesce(r.aux->>'traffic_dir','forward'), ']') AS metric,\n\tr.metric_value AS value\nFROM ps_test_results r\nLEFT JOIN ships s ON s.src = r.src\nWHERE r.metric_name = 'throughput_mbps'\n\tAND $__timeFilter(r.ts)\n\tAND r.src IN (${ship:sqlstring})\n\tAND r.dst IN (${dst:sqlstring})\n\tAND ('${direction}' = 'both' OR coalesce(r.aux->>'traffic_dir','forward')='${direction}')\nORDER BY 1"
        }
      ]
    },
