      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf1s1g3beeccge"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT\n\tn.ts AS time,\n\tn.latitude,\n\tn.longitude,\n\tCOALESCE(s.display_name, n.vessel_id) AS ship\nFROM nav_data n\nLEFT JOIN ships s ON s.vessel_id = n.vessel_id\nWHERE $__timeFilter(n.ts)\n\tAND n.vessel_id IN (SELECT vessel_id FROM ships WHERE src IN (${ship:sqlstring}) AND vessel_id IS NOT NULL)\n\tAND n.latitude IS NOT NULL AND n.longitude IS NOT NULL\nORDER BY n.ts"
        }
      ]
    },
    {
