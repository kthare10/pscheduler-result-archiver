      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "hideZeros": false,
          "mode": "multi",
          "sort": "none"
        }
      },
      "pluginVersion": "12.2.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf1s1g3beeccge"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT\n\t$__time(r.ts),\n\tconcat(COALESCE(s.display_name, r.src), ' → ', r.dst, ' [', coalesce(r.aux->>'traffic_dir','forward'), ']') AS metric,\n\tr.metric_value AS value\nFROM ps_test_results r\nLEFT JOIN ships s ON s.src = r.src\nWHERE r.metric_name = 'throughput_mbps'\n\tAND $__timeFilter(r.ts)\n\tAND r.src IN (${ship:sqlstring})\n\tAND r.dst IN (${dst:sqlstring})\n\tAND ('${direction}' = 'both' OR coalesce(r.aux->>'traffic_dir','forward')='${direction}')\nORDER BY 1"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf1s1g3beeccge"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "B",
          "rawSql": "SELECT\n\ttime_bucket('1 minute', n.ts) AS time,\n\tconcat(COALESCE(s.display_name, n.vessel_id), ' — Roll (°)') AS metric,\n\tAVG(ABS(n.roll_deg)) AS value\nFROM nav_data n\nLEFT JOIN ships s ON s.vessel_id = n.vessel_id\nWHERE $__timeFilter(n.ts)\n\tAND n.vessel_id IN (SELECT vessel_id FROM ships WHERE src IN (${ship:sqlstring}) AND vessel_id IS NOT NULL)\n\tAND n.roll_deg IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1"
        },
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "cf1s1g3beeccge"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "C",
          "rawSql": "SELECT\n\ttime_bucket('1 minute', n.ts) AS time,\n\tconcat(COALESCE(s.display_name, n.vessel_id), ' — Pitch (°)') AS metric,\n\tAVG(ABS(n.pitch_deg)) AS value\nFROM nav_data n\nLEFT JOIN ships s ON s.vessel_id = n.vessel_id\nWHERE $__timeFilter(n.ts)\n\tAND n.vessel_id IN (SELECT vessel_id FROM ships WHERE src IN (${ship:sqlstring}) AND vessel_id IS NOT NULL)\n\tAND n.pitch_deg IS NOT NULL\nGROUP BY 1, 2\nORDER BY 1"
        }
      ]
    },
