          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT\n\t$__time(r.ts),\n\tconcat(\n\t\tCASE r.metric_name\n\t\t\tWHEN 'min_rtt_ms' THEN 'Minimum - '\n\t\t\tWHEN 'mean_rtt_ms' THEN 'Mean - '\n\t\t\tWHEN 'max_rtt_ms' THEN 'Max - '\n\t\t\tELSE ''\n\t\tEND,\n\t\tCOALESCE(s.display_name, r.src),' → ',r.dst,' (',r.tool,') [',coalesce(r.aux->>'traffic_dir','forward'),']',\n\t\tCASE WHEN r.aux ? 'ip_version' THEN concat(' - IPv', r.aux->>'ip_version') ELSE '' END\n\t) AS metric,\n\tr.metric_value AS value\nFROM ps_test_results r\nLEFT JOIN ships s ON s.src = r.src\nWHERE r.metric_name IN ('min_rtt_ms','mean_rtt_ms','max_rtt_ms')\n\tAND $__timeFilter(r.ts)\n\tAND r.src IN (${ship:sqlstring})\n\tAND r.dst IN (${dst:sqlstring})\nORDER BY 1"
        }
      ],
      "title": "RTT (ms) — Forward & Reverse",
      "type": "timeseries"
