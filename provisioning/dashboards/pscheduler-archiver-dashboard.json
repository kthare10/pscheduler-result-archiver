          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "refId": "A",
          "rawSql": "SELECT\n\t$__time(t.ts),\n\tt.ship AS \"Ship\",\n\tt.dst AS \"Destination\",\n\tt.hop_count AS \"Hop Count\",\n\tt.route_str AS \"Route (IP sequence)\"\nFROM (\n\tSELECT\n\t\tMIN(h.ts) AS ts,\n\t\th.run_id,\n\t\tCOALESCE(s.display_name, h.src) AS ship,\n\t\th.dst,\n\t\tSTRING_AGG(h.hop_ip, ' → ' ORDER BY h.hop_idx) AS route_str,\n\t\tCOUNT(*) AS hop_count\n\tFROM ps_trace_hops h\n\tLEFT JOIN ships s ON s.src = h.src\n\tWHERE $__timeFilter(h.ts)\n\t\tAND h.src IN (${ship:sqlstring})\n\t\tAND h.dst IN (${dst:sqlstring})\n\tGROUP BY h.run_id, 3, h.dst\n) t\nORDER BY time DESC\nLIMIT 500;"
        }
      ],
      "title": "Unique Traceroutes Observed",
      "type": "table"
    }
